{
  "name": "Order By",
  "description": "Orders data according to row-wise or column-wise metrics.",
  "tags": [
    "preprocessing"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/orderBy_operator"
  ],
  "properties": [
    {
      "kind": "BooleanProperty",
      "name": "decreasing",
      "defaultValue": false,
      "description": "Should the sort order be increasing or decreasing?"
    },
    {
      "kind": "EnumeratedProperty",
      "name": "function",
      "defaultValue": "mean",
      "values": [
        "mean",
        "median",
        "sd",
        "var",
        "min",
        "max",
        "IQR",
        "rev"
      ],
      "description": "Function to apply to row- and column-wise."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "row",
            "type": "",
            "description": "rows to order",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "1..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "column",
            "type": "",
            "description": "columns to order",
            "ontologyMapping": "observation",
            "crosstabMapping": "column",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "y-axis",
                "type": "double",
                "description": "input data, per cell",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "column"
              ],
              "rColumns": [
                "column"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "corder",
                  "type": "double"
                }
              ]
            }
          },
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "row"
              ],
              "rColumns": [
                "row"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "rorder",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}